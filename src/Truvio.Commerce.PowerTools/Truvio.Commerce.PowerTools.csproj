<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Truvio.Commerce.PowerTools</RootNamespace>
    <AssemblyName>Truvio.Commerce.PowerTools</AssemblyName>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>

    <!-- NuGet package metadata -->
    <PackageId>Truvio.Commerce.PowerTools</PackageId>
    <!-- Prerelease suffix renders as the BETA flag in the DW10 admin "Available apps" list -->
    <Version>0.8.0-beta</Version>
    <AssemblyVersion>0.8.0.0</AssemblyVersion>
    <Title>Truvio PowerTools</Title>
    <!-- The description lists every tool in the suite — keep it current when a tool ships. -->
    <Description>Truvio PowerTools — a growing suite of admin power tools for Dynamicweb 10 by JustDynamics, in one dedicated "PowerTools" area of the administration.

Included tools:
• Content Access Viewer — opens straight on the overview; pick any security account (role, group, or user - searchable) and a website from the toolbar and see its effective CONTENT access across pages, grid rows, and paragraphs. Denials explain the gate: which rule blocks, and who IS granted.
• Content Access Warnings — content-permission misconfiguration findings: ineffective group grants, gated sign-in pages, ignored legacy permission columns, orphaned grants.
• Price Explainer — pick a user (or the anonymous visitor) and a product: can they see it, what do they pay, and why — the assortment that grants or blocks it, the price-matrix row that wins and why every other row lost, the product discounts that apply; switch currency, shop, quantity and date.
• Operations Console — install health in one place: scheduled tasks (state, runs, who ran them, failing and stale tasks), integration activities (last result, broken task→activity links), logs and storage (log folders and largest tables, retention, growth findings), recent changes.
• Index &amp; Query Inspector — repositories and indexes with build status and schema, field where-used (dangling and unused fields), a query linter (incl. the blank-parameter leak that returns the whole index), and a live document browser that searches every schema field, shows where a term hits, and diffs product documents against the database.
• Query Tester — run any repository query with your own parameter values and see the hits, the executed Lucene query, a clause-by-clause trace, each clause's impact, why a given document is missing, facet counts, and what to change; results carry search highlighting (where each value occurs, database texts included) and a per-document explanation panel; a finished test is a shareable link.
• Settings — tune every tool: linter suppressions, thresholds, caps, presets, per-section toggles.

Every list has toolbar search.

Requires Dynamicweb 10.8 or newer. Issues and feature requests: https://github.com/justdynamics/Truvio.Commerce.PowerTools/issues</Description>
    <Authors>JustDynamics</Authors>
    <Company>JustDynamics</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- Shown in the DW10 admin "Available apps" list: NuGetAddinProvider maps the package's
         IconUrl (served by nuget.org from this embedded icon) onto AddinInfo.Image. -->
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/justdynamics/Truvio.Commerce.PowerTools</PackageProjectUrl>
    <RepositoryUrl>https://github.com/justdynamics/Truvio.Commerce.PowerTools</RepositoryUrl>
    <!-- "dynamicweb-app-store" + "Addin" + "dw10" are required by the DW10 admin app-store
         search (NuGetAddinProvider DEFAULT_SEARCH_TERM). -->
    <PackageTags>dynamicweb-app-store Addin dw10 tools security permissions personalisation content commerce prices assortments discounts operations scheduled-tasks integration logs indexing search queries truvio-powertools justdynamics dynamicweb</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Truvio.Commerce.PowerTools.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Overridable per host: dotnet build -p:DynamicwebVersion=10.27.9 produces a build
         binding against that platform version (a DLL compiled against a newer DW version
         fails to load silently on an older host). -->
    <DynamicwebVersion Condition="'$(DynamicwebVersion)' == ''">10.28.1-PreRelease</DynamicwebVersion>
    <!-- Numeric part for feature gating (strips prerelease suffixes). -->
    <DwVersionNumeric>$(DynamicwebVersion.Split('-')[0])</DwVersionNumeric>
    <!-- ListScreenBase.GetScreenExplanation exists from 10.24; older hosts skip the subtitle. -->
    <DefineConstants Condition="$([System.Version]::Parse('$(DwVersionNumeric)').CompareTo($([System.Version]::Parse('10.24.0')))) &gt;= 0">$(DefineConstants);DW_HAS_SCREEN_EXPLANATION</DefineConstants>
    <!-- BadgeType.Outline* variants exist from 10.23; older hosts fall back to solid badges. -->
    <DefineConstants Condition="$([System.Version]::Parse('$(DwVersionNumeric)').CompareTo($([System.Version]::Parse('10.23.0')))) &gt;= 0">$(DefineConstants);DW_HAS_OUTLINE_BADGES</DefineConstants>
    <!-- A query clause whose field is not in the index schema THROWS in Helpers.ParseQueryExpressionInternal
         up to 10.19.7, and from 10.21.13 only logs a warning and drops the clause. The Query tester has to
         report the right consequence, so the behaviour is compiled in per host. (10.20.x is not in the
         local package cache; 10.21 is the first version verified to warn.) -->
    <DefineConstants Condition="$([System.Version]::Parse('$(DwVersionNumeric)').CompareTo($([System.Version]::Parse('10.21.0')))) &gt;= 0">$(DefineConstants);DW_DROPS_UNKNOWN_CLAUSE_FIELD</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dynamicweb" Version="$(DynamicwebVersion)" />
    <PackageReference Include="Dynamicweb.Application.UI" Version="$(DynamicwebVersion)" />
    <PackageReference Include="Dynamicweb.CoreUI.Rendering" Version="$(DynamicwebVersion)" />
    <PackageReference Include="Dynamicweb.Ecommerce" Version="$(DynamicwebVersion)" />
  </ItemGroup>

</Project>
